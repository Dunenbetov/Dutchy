# Backend (apps/backend) — copy to apps/backend/.env
OPENAI_API_KEY=sk-your-key-here
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# Production (Railway API): NODE_ENV=production, CORS_ORIGIN, OPENAI_API_KEY required

# Frontend build (Railway web service, build-time)
# API_URL=https://your-api.up.railway.app
# (script appends /api if missing)
